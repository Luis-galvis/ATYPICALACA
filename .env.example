# Variables de entorno para el servidor Express (VPS)
# Copia este archivo como .env y completa los valores reales

# URL de tu proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key (segura para el frontend - protegida por RLS)
SUPABASE_KEY=tu_anon_key

# Service Role Key (SOLO para el servidor, NUNCA en el frontend)
SUPABASE_SERVICE_KEY=tu_service_role_key

# Puerto del servidor Express (default: 3000)
PORT=3000

# IDs de tu base de datos
ADMIN_USER_ID=tu_admin_user_id
LOCAL_ID=tu_local_id
TENANT_ID=tu_tenant_id
